# Copy to .env and fill in. Never commit .env.

# "testnet" or "live". Stays on testnet until every trading command is tested.
TRADEBOT_ENV=testnet

# Spot and futures testnets are separate sites with separate keys:
#   spot:    https://testnet.binance.vision  (log in with GitHub, "Generate HMAC_SHA256 Key")
#   futures: https://testnet.binancefuture.com (API Key tab under the order panel)
TRADEBOT_SPOT_API_KEY=
TRADEBOT_SPOT_API_SECRET=
TRADEBOT_FUTURES_API_KEY=
TRADEBOT_FUTURES_API_SECRET=

# Safety defaults (open questions in the spec, change freely)
TRADEBOT_WHITELIST=BTC,ETH,SOL
TRADEBOT_MAX_LEVERAGE=10
TRADEBOT_MARGIN_TYPE=ISOLATED
TRADEBOT_CONFIRM_TTL_SECONDS=60

# SQLite trade log
TRADEBOT_DB_PATH=tradebot.db

# Web login: run `python -m tradebot.auth` and paste its two lines here
TRADEBOT_WEB_PASSWORD_HASH=
TRADEBOT_WEB_TOTP_SECRET=
TRADEBOT_WEB_SESSION_HOURS=12
# true when served over HTTPS via `tailscale serve`
TRADEBOT_WEB_COOKIE_SECURE=false
